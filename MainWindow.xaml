<Window x:Class="RightDock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Right Dock"
        Width="50" Height="900"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        WindowStartupLocation="Manual" Left="-10000" Top="-10000"
        Background="#FF1C1C1C"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Border BorderBrush="#26FFFFFF" BorderThickness="1,0,0,0" Background="#FF1C1C1C">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" Margin="0,8,0,0"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="AppsPanel"/>
            </ScrollViewer>

            <StackPanel Grid.Row="1" Margin="0,4,0,12">
                <Button x:Name="AddButton" Style="{StaticResource DockButton}"
                        ToolTip="Add app" ToolTipService.Placement="Left"
                        Click="AddButton_Click">
                    <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="16"
                               Foreground="#E6FFFFFF"/>
                </Button>
                <Button x:Name="SettingsButton" Style="{StaticResource DockButton}"
                        ToolTip="Settings" ToolTipService.Placement="Left"
                        Margin="0,2,0,0" Click="SettingsButton_Click">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="16"
                               Foreground="#E6FFFFFF"/>
                </Button>
                <Button x:Name="CloseButton" Style="{StaticResource DockButton}"
                        ToolTip="Close dock" ToolTipService.Placement="Left"
                        Margin="0,2,0,0" Click="CloseButton_Click">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="14"
                               Foreground="#E6FFFFFF"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
