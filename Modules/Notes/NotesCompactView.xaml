<UserControl x:Class="RightDock.Modules.Notes.NotesCompactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             TextOptions.TextFormattingMode="Display"
             UseLayoutRounding="True" SnapsToDevicePixels="True">

    <StackPanel>
        <Grid Margin="0,0,0,7">
            <TextBlock Style="{StaticResource MdSectionTitle}" Text="QUICK NOTE" Margin="1,0,0,0"/>
            <TextBlock x:Name="CountText" Style="{StaticResource MdCaption}" HorizontalAlignment="Right"/>
        </Grid>

        <TextBox x:Name="CaptureInput" Style="{StaticResource MdInput}" Height="64"
                 AutomationProperties.AutomationId="NoteCapture"
                 AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                 VerticalScrollBarVisibility="Auto" KeyDown="Capture_KeyDown"/>

        <Grid Margin="0,7,0,0">
            <TextBlock Style="{StaticResource MdCaption}" Text="Ctrl+Enter to save." VerticalAlignment="Center"
                       Margin="1,0,0,0"/>
            <Button Style="{StaticResource MdPrimaryButton}" Content="Save note" Padding="12,6"
                    HorizontalAlignment="Right" Click="Capture_Click"/>
        </Grid>

        <Grid Margin="1,14,0,4">
            <TextBlock Style="{StaticResource MdSectionTitle}" Text="RECENT NOTES" Margin="0"/>
            <Button Style="{StaticResource MdGhostButton}" Content="Open dashboard" FontSize="10.5"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Click="Open_Click"/>
        </Grid>

        <StackPanel x:Name="NotePanel"/>
        <TextBlock x:Name="EmptyText" Style="{StaticResource MdCaption}" Margin="1,2,0,0"
                   Text="No notes yet."/>
    </StackPanel>
</UserControl>
