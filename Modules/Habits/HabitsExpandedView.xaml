<UserControl x:Class="RightDock.Modules.Habits.HabitsExpandedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             TextOptions.TextFormattingMode="Display"
             UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel>
            <Grid Margin="1,0,0,6">
                <TextBlock Style="{StaticResource MdSectionTitle}" Text="TODAY'S HABITS" Margin="0"/>
                <Button Style="{StaticResource MdGhostButton}" Content="+ New habit"
                        FontSize="10.5" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Click="New_Click"/>
            </Grid>

            <TextBlock x:Name="ListCountText" Style="{StaticResource MdCaption}" Margin="1,0,0,4"/>

            <ScrollViewer MaxHeight="540" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="HabitPanel"/>
            </ScrollViewer>

            <TextBlock x:Name="EmptyText" Style="{StaticResource MdCaption}" Margin="1,4,0,0"
                       Text="No habits yet. Use New habit to add one."/>
        </StackPanel>

        <ScrollViewer Grid.Column="1" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource MdCard}" Padding="18">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock x:Name="EditorTitle" Style="{StaticResource MdTitle}" Text="New habit"/>
                            <TextBlock x:Name="StatusText" FontSize="10.5" Foreground="#9CC7E9"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Style="{StaticResource MdSectionTitle}" Text="NAME"/>
                        <TextBox x:Name="NameInput" Style="{StaticResource MdInput}"
                                 AutomationProperties.AutomationId="HabitName"
                                 TextChanged="Editor_TextChanged"/>

                        <TextBlock Style="{StaticResource MdSectionTitle}" Text="DESCRIPTION" Margin="1,12,0,6"/>
                        <TextBox x:Name="DescriptionInput" Style="{StaticResource MdInput}" Height="52"
                                 AutomationProperties.AutomationId="HabitDescription"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"/>

                        <TextBlock Style="{StaticResource MdSectionTitle}" Text="TRACKING" Margin="1,12,0,6"/>
                        <WrapPanel>
                            <ToggleButton x:Name="TypeBoolean" Style="{StaticResource MdChip}" Content="Yes / no"
                                          Tag="boolean" Click="Type_Click"/>
                            <ToggleButton x:Name="TypeCounter" Style="{StaticResource MdChip}" Content="Counter"
                                          Tag="counter" Click="Type_Click"/>
                            <ToggleButton x:Name="TypeDuration" Style="{StaticResource MdChip}" Content="Duration"
                                          Tag="duration" Click="Type_Click"/>
                        </WrapPanel>

                        <StackPanel Orientation="Horizontal" Margin="1,6,0,0">
                            <StackPanel Width="104" Margin="0,0,10,0">
                                <TextBlock Style="{StaticResource MdSectionTitle}" Text="TARGET" Margin="0,0,0,6"/>
                                <TextBox x:Name="TargetInput" Style="{StaticResource MdInput}"
                                         AutomationProperties.AutomationId="HabitTarget"/>
                            </StackPanel>
                            <StackPanel Width="150">
                                <TextBlock Style="{StaticResource MdSectionTitle}" Text="UNIT" Margin="0,0,0,6"/>
                                <TextBox x:Name="UnitInput" Style="{StaticResource MdInput}"
                                         AutomationProperties.AutomationId="HabitUnit"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock x:Name="TargetHint" Style="{StaticResource MdCaption}" Margin="1,6,0,0"
                                   Text="Counter habits count up; duration habits add 5 minutes per tap."/>

                        <TextBlock x:Name="ErrorText" Foreground="#FF9A9A" FontSize="11" Margin="1,8,0,0"
                                   TextWrapping="Wrap" Visibility="Collapsed"/>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Style="{StaticResource MdPrimaryButton}" Content="Save habit"
                                    Click="Save_Click"/>
                            <Button Grid.Column="1" Style="{StaticResource MdSecondaryButton}" Content="Clear"
                                    Margin="8,0,0,0" HorizontalAlignment="Left" Click="Clear_Click"/>
                            <Button x:Name="DeleteButton" Grid.Column="2" Style="{StaticResource MdDangerButton}"
                                    Content="Delete" IsEnabled="False" Click="Delete_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MdCard}" Margin="0,12,0,0" Padding="16">
                    <StackPanel>
                        <Grid>
                            <TextBlock Style="{StaticResource MdSectionTitle}" Text="LAST 7 DAYS" Margin="0"/>
                            <TextBlock x:Name="WeekSummary" FontSize="10.5" Foreground="#8C8C8C"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <StackPanel x:Name="WeekPanel" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
