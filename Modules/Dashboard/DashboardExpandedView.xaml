<UserControl x:Class="RightDock.Modules.Dashboard.DashboardExpandedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             TextOptions.TextFormattingMode="Display"
             UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="1,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource MdTitle}" Text="Daily overview" VerticalAlignment="Center"/>
                <TextBlock x:Name="DateText" Style="{StaticResource MdCaption}" Margin="12,0,0,1"
                           VerticalAlignment="Bottom"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="UpdatedText" Style="{StaticResource MdCaption}" Margin="0,0,10,0"
                           VerticalAlignment="Center"/>
                <Button Style="{StaticResource MdSecondaryButton}" Content="Refresh"
                        AutomationProperties.AutomationId="DashboardRefreshButton" Click="Refresh_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <Border Style="{StaticResource MdCard}" Padding="18">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MdSectionTitle}" Text="TODAY AT A GLANCE" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Focus today" Foreground="#E4E4E4" FontSize="11.5"/>
                                <TextBlock x:Name="OverviewFocusMeta" Style="{StaticResource MdCaption}" Margin="0,1,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="OverviewFocusValue" Grid.Column="1" FontSize="14" FontWeight="SemiBold"
                                       Foreground="#F5F5F5" VerticalAlignment="Center"
                                       AutomationProperties.AutomationId="DashboardOverviewFocus"/>
                        </Grid>

                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Tasks" Foreground="#E4E4E4" FontSize="11.5"/>
                                <TextBlock x:Name="OverviewTaskMeta" Style="{StaticResource MdCaption}" Margin="0,1,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="OverviewTaskValue" Grid.Column="1" FontSize="14" FontWeight="SemiBold"
                                       Foreground="#F5F5F5" VerticalAlignment="Center"
                                       AutomationProperties.AutomationId="DashboardOverviewTasks"/>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Habits" Foreground="#E4E4E4" FontSize="11.5"/>
                                <TextBlock x:Name="OverviewHabitMeta" Style="{StaticResource MdCaption}" Margin="0,1,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="OverviewHabitValue" Grid.Column="1" FontSize="14" FontWeight="SemiBold"
                                       Foreground="#F5F5F5" VerticalAlignment="Center"
                                       AutomationProperties.AutomationId="DashboardOverviewHabits"/>
                        </Grid>
                        <ProgressBar x:Name="OverviewHabitProgress" Style="{StaticResource MdProgress}"
                                     Margin="0,2,0,9" Minimum="0" Maximum="1" Value="0"/>

                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Medication" Foreground="#E4E4E4" FontSize="11.5"/>
                                <TextBlock x:Name="OverviewMedMeta" Style="{StaticResource MdCaption}" Margin="0,1,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock x:Name="OverviewMedValue" Grid.Column="1" FontSize="14" FontWeight="SemiBold"
                                       Foreground="#F5F5F5" VerticalAlignment="Center"
                                       AutomationProperties.AutomationId="DashboardOverviewMedication"/>
                        </Grid>

                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Reminders" Foreground="#E4E4E4" FontSize="11.5"/>
                                <TextBlock x:Name="OverviewReminderMeta" Style="{StaticResource MdCaption}" Margin="0,1,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock x:Name="OverviewReminderValue" Grid.Column="1" FontSize="14" FontWeight="SemiBold"
                                       Foreground="#F5F5F5" VerticalAlignment="Center"
                                       AutomationProperties.AutomationId="DashboardOverviewReminders"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Notes" Foreground="#E4E4E4" FontSize="11.5"/>
                                <TextBlock x:Name="OverviewNoteMeta" Style="{StaticResource MdCaption}" Margin="0,1,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock x:Name="OverviewNoteValue" Grid.Column="1" FontSize="14" FontWeight="SemiBold"
                                       Foreground="#F5F5F5" VerticalAlignment="Center"
                                       AutomationProperties.AutomationId="DashboardOverviewNotes"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MdCard}" Margin="0,12,0,0" Padding="14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MdSectionTitle}" Text="QUICK ACTIONS" Margin="0,0,0,6"/>
                        <UniformGrid Columns="2">
                            <Button Style="{StaticResource MdSecondaryButton}" Content="Focus timer"
                                    Margin="0,0,5,5" Click="OpenFocus_Click"/>
                            <Button Style="{StaticResource MdSecondaryButton}" Content="Tasks"
                                    Margin="5,0,0,5" Click="OpenTasks_Click"/>
                            <Button Style="{StaticResource MdSecondaryButton}" Content="Plan day"
                                    Margin="0,5,5,0" Click="OpenCalendar_Click"/>
                            <Button Style="{StaticResource MdSecondaryButton}" Content="Statistics"
                                    Margin="5,5,0,0" Click="OpenStatistics_Click"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Grid Grid.Column="1" Margin="16,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource MdCard}" Grid.Row="0" Grid.Column="0"
                        Margin="0,0,10,10" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <TextBlock Style="{StaticResource MdSectionTitle}" Text="FOCUS" Margin="0"/>
                            <TextBlock x:Name="FocusCardSessions" Style="{StaticResource MdCaption}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <StackPanel Grid.Row="1" Margin="0,2,0,0">
                            <TextBlock x:Name="FocusCardTime" FontSize="27" FontWeight="SemiBold"
                                       Foreground="#F7F7F7"
                                       AutomationProperties.AutomationId="DashboardFocusCardTime"/>
                            <TextBlock x:Name="FocusCardMeta" Style="{StaticResource MdCaption}"/>
                            <UniformGrid x:Name="FocusChart" Columns="7" Height="58" Margin="0,6,0,0"/>
                        </StackPanel>

                        <Button Grid.Row="2" Style="{StaticResource MdGhostButton}" Content="Open focus timer"
                                HorizontalAlignment="Left" Click="OpenFocus_Click"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource MdCard}" Grid.Row="0" Grid.Column="1"
                        Margin="0,0,0,10" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <TextBlock Style="{StaticResource MdSectionTitle}" Text="TASKS" Margin="0"/>
                            <TextBlock x:Name="TaskCardDone" Style="{StaticResource MdCaption}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <UniformGrid Grid.Row="1" Columns="3" VerticalAlignment="Center" Margin="0,4,0,0">
                            <StackPanel>
                                <TextBlock x:Name="TaskCardDue" FontSize="21" FontWeight="SemiBold"
                                           Foreground="#F5F5F5" HorizontalAlignment="Center"
                                           AutomationProperties.AutomationId="DashboardTaskDue"/>
                                <TextBlock Style="{StaticResource MdCaption}" Text="Due today"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock x:Name="TaskCardOverdue" FontSize="21" FontWeight="SemiBold"
                                           Foreground="#EF8080" HorizontalAlignment="Center"
                                           AutomationProperties.AutomationId="DashboardTaskOverdue"/>
                                <TextBlock Style="{StaticResource MdCaption}" Text="Overdue"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock x:Name="TaskCardCompleted" FontSize="21" FontWeight="SemiBold"
                                           Foreground="#9CC7E9" HorizontalAlignment="Center"
                                           AutomationProperties.AutomationId="DashboardTaskCompleted"/>
                                <TextBlock Style="{StaticResource MdCaption}" Text="Done today"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </UniformGrid>

                        <Button Grid.Row="2" Style="{StaticResource MdGhostButton}" Content="Open tasks"
                                HorizontalAlignment="Left" Click="OpenTasks_Click"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource MdCard}" Grid.Row="1" Grid.Column="0"
                        Margin="0,0,10,10" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <TextBlock Style="{StaticResource MdSectionTitle}" Text="HABITS" Margin="0"/>
                            <TextBlock x:Name="HabitCardStreak" Style="{StaticResource MdCaption}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <StackPanel Grid.Row="1" Margin="0,2,0,0">
                            <TextBlock x:Name="HabitCardValue" Style="{StaticResource MdValue}"
                                       AutomationProperties.AutomationId="DashboardHabitCardValue"/>
                            <ProgressBar x:Name="HabitCardProgress" Style="{StaticResource MdProgress}"
                                         Margin="0,7,0,0" Minimum="0" Maximum="1" Value="0"/>
                            <TextBlock x:Name="HabitCardMeta" Style="{StaticResource MdCaption}" Margin="0,5,0,0"/>
                        </StackPanel>

                        <Button Grid.Row="2" Style="{StaticResource MdGhostButton}" Content="Open habits"
                                HorizontalAlignment="Left" Click="OpenHabits_Click"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource MdCard}" Grid.Row="1" Grid.Column="1"
                        Margin="0,0,0,10" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <TextBlock Style="{StaticResource MdSectionTitle}" Text="MEDICATION" Margin="0"/>
                            <TextBlock x:Name="MedCardTotal" Style="{StaticResource MdCaption}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <StackPanel Grid.Row="1" Margin="0,2,0,0">
                            <TextBlock x:Name="MedCardValue" Style="{StaticResource MdValue}"
                                       AutomationProperties.AutomationId="DashboardMedicationCardValue"/>
                            <TextBlock x:Name="MedCardMeta" Style="{StaticResource MdBody}" FontSize="11.5"
                                       Margin="0,2,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="MedCardNext" Style="{StaticResource MdCaption}" Margin="0,4,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button Grid.Row="2" Style="{StaticResource MdGhostButton}" Content="Open medication"
                                HorizontalAlignment="Left" Click="OpenMedication_Click"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource MdCard}" Grid.Row="2" Grid.Column="0"
                        Margin="0,0,10,0" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <TextBlock Style="{StaticResource MdSectionTitle}" Text="HEALTH" Margin="0"/>
                            <TextBlock x:Name="HealthCardWeight" Style="{StaticResource MdCaption}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <StackPanel x:Name="HealthCardPanel" Grid.Row="1" Margin="0,3,0,0"
                                    AutomationProperties.AutomationId="DashboardHealthCardPanel"/>

                        <Button Grid.Row="2" Style="{StaticResource MdGhostButton}" Content="Open health"
                                HorizontalAlignment="Left" Click="OpenHealth_Click"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource MdCard}" Grid.Row="2" Grid.Column="1"
                        Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource MdSectionTitle}" Text="REMINDERS &amp; NOTES" Margin="0"/>

                        <Grid Grid.Row="1" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock x:Name="ReminderCardValue" FontSize="18" FontWeight="SemiBold"
                                           Foreground="#F5F5F5"
                                           AutomationProperties.AutomationId="DashboardReminderCardValue"/>
                                <TextBlock x:Name="ReminderCardMeta" Style="{StaticResource MdCaption}"
                                           Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="NoteCardValue" FontSize="18" FontWeight="SemiBold"
                                           Foreground="#F5F5F5"
                                           AutomationProperties.AutomationId="DashboardNoteCardValue"/>
                                <TextBlock x:Name="NoteCardMeta" Style="{StaticResource MdCaption}"
                                           Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <Button Style="{StaticResource MdGhostButton}" Content="Reminders"
                                    Click="OpenReminders_Click"/>
                            <Button Style="{StaticResource MdGhostButton}" Content="Notes"
                                    Margin="10,0,0,0" Click="OpenNotes_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
