<UserControl x:Class="RightDock.Modules.Focus.FocusExpandedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             TextOptions.TextFormattingMode="Display"
             UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel>
            <Border Style="{StaticResource MdCard}" Padding="18">
                <StackPanel>
                    <Grid>
                        <TextBlock Style="{StaticResource MdSectionTitle}" Text="FOCUS TIMER" Margin="0"/>
                        <TextBlock x:Name="PhaseText" Text="READY" FontSize="10.5" Foreground="#8C8C8C"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <TextBlock x:Name="ClockText" Text="25:00" FontSize="62" FontWeight="SemiBold"
                               Foreground="#F7F7F7" Margin="0,-2,0,4"/>

                    <TextBlock x:Name="TaskText" Style="{StaticResource MdCaption}" Text="No task linked"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>

                    <ProgressBar x:Name="Progress" Style="{StaticResource MdProgress}" Margin="0,14,0,0"
                                 Minimum="0" Maximum="1" Value="0"/>

                    <UniformGrid Columns="4" Margin="0,14,0,0">
                        <ToggleButton x:Name="Preset15" Style="{StaticResource MdChip}" Content="15 min"
                                      Margin="0,0,5,0" Tag="15" Click="Preset_Click"/>
                        <ToggleButton x:Name="Preset25" Style="{StaticResource MdChip}" Content="25 min"
                                      Margin="0,0,5,0" Tag="25" Click="Preset_Click"/>
                        <ToggleButton x:Name="Preset45" Style="{StaticResource MdChip}" Content="45 min"
                                      Margin="0,0,5,0" Tag="45" Click="Preset_Click"/>
                        <ToggleButton x:Name="Preset60" Style="{StaticResource MdChip}" Content="60 min"
                                      Margin="0" Tag="60" Click="Preset_Click"/>
                    </UniformGrid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="PrimaryButton" Style="{StaticResource MdPrimaryButton}"
                                Content="Start focus" Click="Primary_Click"/>
                        <Button x:Name="ResetButton" Grid.Column="1" Style="{StaticResource MdSecondaryButton}"
                                Content="Reset" Margin="8,0,0,0" Click="Reset_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MdCard}" Margin="0,12,0,0" Padding="16">
                <StackPanel>
                    <TextBlock Style="{StaticResource MdSectionTitle}" Text="LINKED TASK"/>
                    <TextBlock x:Name="TaskHint" Style="{StaticResource MdCaption}" Margin="0,0,0,8"
                               Text="Pick a task to record it with the session."/>
                    <WrapPanel x:Name="TaskPanel"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="16,0,0,0">
            <Border Style="{StaticResource MdCard}" Padding="16">
                <StackPanel>
                    <Grid>
                        <TextBlock Style="{StaticResource MdSectionTitle}" Text="LAST 7 DAYS" Margin="0"/>
                        <TextBlock x:Name="WeekTotal" Text="" FontSize="10.5" Foreground="#8C8C8C"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                    <UniformGrid x:Name="StatsGrid" Columns="7" Height="96" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Grid Margin="1,16,0,6">
                <TextBlock Style="{StaticResource MdSectionTitle}" Text="SESSION HISTORY" Margin="0"/>
                <TextBlock x:Name="HistorySummary" FontSize="10.5" Foreground="#8C8C8C"
                           HorizontalAlignment="Right"/>
            </Grid>

            <ScrollViewer MaxHeight="330" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="HistoryPanel"/>
            </ScrollViewer>

            <TextBlock x:Name="EmptyHistory" Style="{StaticResource MdCaption}" Margin="1,2,0,0"
                       Text="Finished sessions appear here with their task and duration."/>
        </StackPanel>
    </Grid>
</UserControl>
