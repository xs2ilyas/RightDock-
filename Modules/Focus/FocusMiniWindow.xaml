<Window x:Class="RightDock.Modules.Focus.FocusMiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Focus timer"
        Width="176" Height="64"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual" Topmost="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        AutomationProperties.AutomationId="FocusMiniWindow">

    <Window.Resources>
        <Style x:Key="MiniButton" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2EFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Shell" Margin="8" CornerRadius="15" Background="#F219202B"
            BorderBrush="#36FFFFFF" BorderThickness="1"
            Cursor="SizeAll" MouseLeftButtonDown="Shell_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.45" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="10,6,8,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TimeText" Text="25:00" FontSize="26" FontWeight="SemiBold"
                       Foreground="#F5F7FA" VerticalAlignment="Center" Margin="2,0,0,0"
                       AutomationProperties.AutomationId="MiniTimerTime"
                       Typography.NumeralAlignment="Tabular"
                       ToolTip="Focus timer"/>

            <Button x:Name="PinButton" Grid.Column="1" Style="{StaticResource MiniButton}"
                    Click="Pin_Click" VerticalAlignment="Center"
                    ToolTip="Always on top"
                    AutomationProperties.Name="Pin timer"
                    AutomationProperties.AutomationId="MiniTimerPinButton">
                <TextBlock x:Name="PinGlyph" Text="&#xE718;"
                           FontFamily="Segoe Fluent Icons" FontSize="12"
                           Foreground="#8B93A3"/>
            </Button>

            <Button x:Name="CloseButton" Grid.Column="2" Style="{StaticResource MiniButton}"
                    Click="Close_Click" VerticalAlignment="Center" Margin="2,0,0,0"
                    ToolTip="Close timer"
                    AutomationProperties.Name="Close timer"
                    AutomationProperties.AutomationId="MiniTimerCloseButton">
                <Path Data="M5.5 5.5 L14.5 14.5 M14.5 5.5 L5.5 14.5"
                      Stroke="#B9C0CD" StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Width="14" Height="14" Stretch="Uniform"/>
            </Button>
        </Grid>
    </Border>
</Window>
