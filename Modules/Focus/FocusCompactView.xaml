<UserControl x:Class="RightDock.Modules.Focus.FocusCompactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             TextOptions.TextFormattingMode="Display"
             UseLayoutRounding="True" SnapsToDevicePixels="True">

    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource MdCard}" Padding="10">
                <StackPanel>
                    <TextBlock Style="{StaticResource MdSectionTitle}" Text="TODAY"/>
                    <TextBlock x:Name="TodayValue" Style="{StaticResource MdValue}" Text="0 min"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource MdCard}" Padding="10" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource MdSectionTitle}" Text="SESSIONS"/>
                    <TextBlock x:Name="SessionsValue" Style="{StaticResource MdValue}" Text="0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Style="{StaticResource MdCard}" Margin="0,8,0,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="ClockText" Text="25:00" FontSize="38" FontWeight="SemiBold"
                               Foreground="#F7F7F7"/>
                    <TextBlock x:Name="PhaseText" Grid.Column="1" Text="Ready" FontSize="10.5"
                               Foreground="#8C8C8C" VerticalAlignment="Center"/>
                </Grid>

                <TextBlock x:Name="TaskText" Style="{StaticResource MdCaption}" Text="No task linked"
                           Margin="1,0,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>

                <ProgressBar x:Name="Progress" Style="{StaticResource MdProgress}" Margin="0,10,0,0"
                             Minimum="0" Maximum="1" Value="0"/>

                <UniformGrid Columns="4" Margin="0,10,0,0">
                    <ToggleButton x:Name="Preset15" Style="{StaticResource MdChip}" Content="15"
                                  Margin="0,0,4,0" Tag="15" Click="Preset_Click"/>
                    <ToggleButton x:Name="Preset25" Style="{StaticResource MdChip}" Content="25"
                                  Margin="0,0,4,0" Tag="25" Click="Preset_Click"/>
                    <ToggleButton x:Name="Preset45" Style="{StaticResource MdChip}" Content="45"
                                  Margin="0,0,4,0" Tag="45" Click="Preset_Click"/>
                    <ToggleButton x:Name="Preset60" Style="{StaticResource MdChip}" Content="60"
                                  Margin="0" Tag="60" Click="Preset_Click"/>
                </UniformGrid>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="PrimaryButton" Style="{StaticResource MdPrimaryButton}"
                            Content="Start focus" Click="Primary_Click"/>
                    <Button x:Name="ResetButton" Grid.Column="1" Style="{StaticResource MdSecondaryButton}"
                            Content="Reset" Margin="7,0,0,0" Click="Reset_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <Grid Margin="1,14,0,0">
            <TextBlock Style="{StaticResource MdSectionTitle}" Text="RECENT SESSIONS" Margin="0"/>
            <Button Style="{StaticResource MdGhostButton}" Content="Open dashboard"
                    FontSize="10.5" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Click="Open_Click"/>
        </Grid>

        <StackPanel x:Name="HistoryPanel" Margin="0,4,0,0"/>

        <TextBlock x:Name="EmptyHistory" Style="{StaticResource MdCaption}" Margin="1,2,0,0"
                   Text="No sessions yet. Start a focus timer."/>
    </StackPanel>
</UserControl>
