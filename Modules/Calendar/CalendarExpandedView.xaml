<UserControl x:Class="RightDock.Modules.Calendar.CalendarExpandedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             TextOptions.TextFormattingMode="Display"
             UseLayoutRounding="True" SnapsToDevicePixels="True">

    <UserControl.Resources>
        <Style x:Key="CalendarDayButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Top"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0FFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="560"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="1,0,0,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="MonthTitle" Style="{StaticResource MdTitle}" Text="Calendar"/>
                    <TextBlock x:Name="MonthMeta" Style="{StaticResource MdCaption}" Margin="10,0,0,1"
                               VerticalAlignment="Bottom"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource MdGhostButton}" Content="&#x2039;" FontSize="16"
                            Padding="7,0" Click="Prev_Click"/>
                    <Button Style="{StaticResource MdSecondaryButton}" Content="Today" Margin="6,0"
                            Click="Today_Click"/>
                    <Button Style="{StaticResource MdGhostButton}" Content="&#x203A;" FontSize="16"
                            Padding="7,0" Click="Next_Click"/>
                </StackPanel>
            </Grid>

            <UniformGrid Grid.Row="1" Columns="7" Margin="0,0,0,2">
                <TextBlock Style="{StaticResource MdCaption}" Text="MON" HorizontalAlignment="Center" FontSize="9"/>
                <TextBlock Style="{StaticResource MdCaption}" Text="TUE" HorizontalAlignment="Center" FontSize="9"/>
                <TextBlock Style="{StaticResource MdCaption}" Text="WED" HorizontalAlignment="Center" FontSize="9"/>
                <TextBlock Style="{StaticResource MdCaption}" Text="THU" HorizontalAlignment="Center" FontSize="9"/>
                <TextBlock Style="{StaticResource MdCaption}" Text="FRI" HorizontalAlignment="Center" FontSize="9"/>
                <TextBlock Style="{StaticResource MdCaption}" Text="SAT" HorizontalAlignment="Center" FontSize="9"/>
                <TextBlock Style="{StaticResource MdCaption}" Text="SUN" HorizontalAlignment="Center" FontSize="9"/>
            </UniformGrid>

            <UniformGrid x:Name="MonthGrid" Grid.Row="2" Columns="7" Rows="6"
                         AutomationProperties.AutomationId="CalendarMonthGrid"/>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="1,8,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                    <Border Width="7" Height="7" CornerRadius="3.5" Background="#9CC7E9" VerticalAlignment="Center"/>
                    <TextBlock Style="{StaticResource MdCaption}" Text="Task" Margin="5,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                    <Border Width="7" Height="7" CornerRadius="3.5" Background="#D6B67A" VerticalAlignment="Center"/>
                    <TextBlock Style="{StaticResource MdCaption}" Text="Reminder" Margin="5,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                    <Border Width="7" Height="7" CornerRadius="3.5" Background="#8FD3A8" VerticalAlignment="Center"/>
                    <TextBlock Style="{StaticResource MdCaption}" Text="Medication" Margin="5,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="7" Height="7" CornerRadius="3.5" Background="#C7B3E8" VerticalAlignment="Center"/>
                    <TextBlock Style="{StaticResource MdCaption}" Text="Focus" Margin="5,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1" Margin="16,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock x:Name="SelectedTitle" Style="{StaticResource MdTitle}" Text="Today"/>
                <TextBlock x:Name="SelectedMeta" Style="{StaticResource MdCaption}" Margin="0,2,0,8"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="AgendaPanel"
                            AutomationProperties.AutomationId="CalendarAgendaPanel"/>
            </ScrollViewer>

            <TextBlock x:Name="EmptyAgenda" Grid.Row="1" Style="{StaticResource MdCaption}"
                       Text="Nothing planned for this day. Add an entry below."
                       VerticalAlignment="Top" Margin="0,6,0,0" Visibility="Collapsed"/>

            <Border Grid.Row="2" Style="{StaticResource MdCard}" Margin="0,10,0,0" Padding="14">
                <StackPanel>
                    <TextBlock Style="{StaticResource MdSectionTitle}" Text="QUICK ADD" Margin="0"/>
                    <TextBlock x:Name="QuickDateText" Style="{StaticResource MdCaption}" Margin="0,0,0,6"/>

                    <TextBox x:Name="QuickTitle" Style="{StaticResource MdInput}"
                             AutomationProperties.AutomationId="CalendarQuickTitle"/>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="QuickTime" Style="{StaticResource MdInput}" Width="64" Text="09:00"
                                 AutomationProperties.AutomationId="CalendarQuickTime"/>
                        <ToggleButton x:Name="QuickTaskChip" Grid.Column="1" Style="{StaticResource MdChip}"
                                      Content="Task" IsChecked="True" Margin="8,0,0,0" Click="QuickKind_Click"/>
                        <ToggleButton x:Name="QuickReminderChip" Grid.Column="2" Style="{StaticResource MdChip}"
                                      Content="Reminder" Margin="2,0,0,0" Click="QuickKind_Click"/>
                        <Button x:Name="AddButton" Grid.Column="4" Style="{StaticResource MdPrimaryButton}"
                                Content="Add" AutomationProperties.AutomationId="CalendarAddButton"
                                Click="Add_Click"/>
                    </Grid>

                    <TextBlock x:Name="QuickError" Foreground="#FF9A9A" FontSize="10.5" Margin="0,6,0,0"
                               TextWrapping="Wrap" Visibility="Collapsed"/>
                    <TextBlock x:Name="QuickStatus" Foreground="#9CC7E9" FontSize="10.5" Margin="0,6,0,0"
                               TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
