<UserControl x:Class="RightDock.Modules.QuickTools.QuickToolsExpandedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             TextOptions.TextFormattingMode="Display"
             UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel>
            <Grid Margin="1,0,0,6">
                <TextBlock Style="{StaticResource MdSectionTitle}" Text="QUICK NOTE" Margin="0"/>
                <Button Style="{StaticResource MdGhostButton}" Content="Open Notes"
                        FontSize="10.5" HorizontalAlignment="Right" VerticalAlignment="Top"
                        AutomationProperties.AutomationId="QuickNoteOpenNotesButton"
                        Click="OpenNotes_Click"/>
            </Grid>

            <TextBox x:Name="QuickNoteInput" Style="{StaticResource MdInput}" Height="118"
                     AutomationProperties.AutomationId="QuickNoteInput"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto" KeyDown="QuickNote_KeyDown"/>

            <Grid Margin="0,8,0,0">
                <TextBlock x:Name="QuickNoteStatus" Style="{StaticResource MdCaption}"
                           Text="Ctrl+Enter to save · filed under the Quick category."
                           VerticalAlignment="Center" Margin="1,0,0,0" TextTrimming="CharacterEllipsis"/>
                <Button x:Name="SaveQuickNoteButton" Style="{StaticResource MdPrimaryButton}" Content="Save note"
                        AutomationProperties.AutomationId="QuickNoteSaveButton"
                        HorizontalAlignment="Right" Click="SaveQuickNote_Click"/>
            </Grid>

            <Border Style="{StaticResource MdDivider}"/>

            <Grid Margin="1,0,0,4">
                <TextBlock Style="{StaticResource MdSectionTitle}" Text="RECENT NOTES" Margin="0"/>
                <TextBlock x:Name="NoteCountText" Style="{StaticResource MdCaption}"
                           HorizontalAlignment="Right" VerticalAlignment="Top"/>
            </Grid>

            <ScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="NotePanel"/>
            </ScrollViewer>

            <TextBlock x:Name="EmptyNotesText" Style="{StaticResource MdCaption}" Margin="1,2,0,0"
                       Text="No notes yet."/>

            <Border Style="{StaticResource MdDivider}"/>

            <TextBlock Style="{StaticResource MdSectionTitle}" Text="TIP"/>
            <TextBlock Style="{StaticResource MdCaption}" Margin="0,0,0,6"
                       Text="Quick notes appear in the Notes module. Pinned notes stay on top there and can be converted to tasks or reminders."/>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="16,0,0,0">
            <Grid Margin="1,0,0,4">
                <TextBlock Style="{StaticResource MdSectionTitle}" Text="BREATHING" Margin="0"/>
                <TextBlock x:Name="BreathStatsText" Style="{StaticResource MdCaption}"
                           HorizontalAlignment="Right" VerticalAlignment="Top"/>
            </Grid>

            <Border Style="{StaticResource MdCard}" Padding="14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Width="126" Height="126" Margin="0,0,20,0" HorizontalAlignment="Left">
                            <Ellipse x:Name="BreathCircle" Width="118" Height="118"
                                     Fill="#1F9CC7E9" Stroke="#4D9CC7E9" StrokeThickness="1.5"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="BreathScale" ScaleX="0.74" ScaleY="0.74"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <TextBlock x:Name="CirclePhaseText" Text="Ready" FontSize="13"
                                       Foreground="#CFE6F8" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="PhaseTitleText" Text="Guided breathing" FontSize="21"
                                       FontWeight="SemiBold" Foreground="#F5F5F5"
                                       AutomationProperties.AutomationId="BreatheExpandedPhaseText"/>
                            <TextBlock x:Name="PhaseDetailText" Style="{StaticResource MdCaption}" Margin="0,2,0,0"
                                       Text="Pick a pattern and press start."/>
                            <TextBlock x:Name="CountdownText" Text="00:00" FontSize="30" FontWeight="SemiBold"
                                       Foreground="#9CC7E9" Margin="0,4,0,0"
                                       AutomationProperties.AutomationId="BreatheExpandedCountdown"/>
                            <TextBlock x:Name="CycleText" Style="{StaticResource MdCaption}"
                                       AutomationProperties.AutomationId="BreatheExpandedCycleText"/>
                            <ProgressBar x:Name="PhaseProgress" Style="{StaticResource MdProgress}"
                                         Margin="0,7,0,0" Minimum="0" Maximum="1" Value="0"/>
                        </StackPanel>
                    </Grid>

                    <WrapPanel x:Name="PatternPanel" Margin="0,10,0,0"/>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Style="{StaticResource MdCaption}" Text="Cycles" VerticalAlignment="Center"
                                   Margin="1,0,7,0"/>
                        <ToggleButton x:Name="Cycles3" Style="{StaticResource MdChip}" Content="3" Margin="0,0,4,0"
                                      AutomationProperties.AutomationId="BreatheCycles3" Click="Cycles_Click"/>
                        <ToggleButton x:Name="Cycles5" Style="{StaticResource MdChip}" Content="5" Margin="0,0,4,0"
                                      AutomationProperties.AutomationId="BreatheCycles5" Click="Cycles_Click"/>
                        <ToggleButton x:Name="Cycles8" Style="{StaticResource MdChip}" Content="8" Margin="0,0,4,0"
                                      AutomationProperties.AutomationId="BreatheCycles8" Click="Cycles_Click"/>
                    </StackPanel>

                    <Grid Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="PauseButton" Style="{StaticResource MdSecondaryButton}" Content="Pause"
                                    Padding="10,5" AutomationProperties.AutomationId="BreathePauseButton"
                                    Click="Pause_Click"/>
                            <Button x:Name="StartButton" Style="{StaticResource MdPrimaryButton}" Content="Start"
                                    Margin="6,0,0,0" AutomationProperties.AutomationId="BreatheStartButton"
                                    Click="Start_Click"/>
                            <Button x:Name="StopButton" Style="{StaticResource MdGhostButton}" Content="Stop"
                                    Margin="9,0,2,0" VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="BreatheStopButton" Click="Stop_Click"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Grid Margin="1,14,0,4">
                <TextBlock Style="{StaticResource MdSectionTitle}" Text="SCREEN BREAK" Margin="0"/>
                <TextBlock x:Name="BreaksTodayText" Style="{StaticResource MdCaption}"
                           HorizontalAlignment="Right" VerticalAlignment="Top"/>
            </Grid>

            <Border Style="{StaticResource MdCard}" Padding="14">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock x:Name="NextBreakText" Text="Off" FontSize="15" Foreground="#F0F0F0"
                                       AutomationProperties.AutomationId="ScreenBreakNextText"/>
                            <TextBlock x:Name="ScreenBreakHint" Style="{StaticResource MdCaption}"
                                       Text="Look 20 feet away for 20 seconds, then stand up and stretch."/>
                        </StackPanel>
                        <ToggleButton x:Name="ScreenBreakToggle" Style="{StaticResource MdChip}" Content="Off"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      AutomationProperties.AutomationId="ScreenBreakToggle" Click="ScreenBreak_Click"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <ToggleButton x:Name="Minutes15" Style="{StaticResource MdChip}" Content="15m" Tag="15"
                                      Margin="0,0,4,0" AutomationProperties.AutomationId="ScreenBreak15"
                                      Click="Minutes_Click"/>
                        <ToggleButton x:Name="Minutes30" Style="{StaticResource MdChip}" Content="30m" Tag="30"
                                      Margin="0,0,4,0" AutomationProperties.AutomationId="ScreenBreak30"
                                      Click="Minutes_Click"/>
                        <ToggleButton x:Name="Minutes45" Style="{StaticResource MdChip}" Content="45m" Tag="45"
                                      Margin="0,0,4,0" AutomationProperties.AutomationId="ScreenBreak45"
                                      Click="Minutes_Click"/>
                        <ToggleButton x:Name="Minutes60" Style="{StaticResource MdChip}" Content="60m" Tag="60"
                                      Margin="0,0,8,0" AutomationProperties.AutomationId="ScreenBreak60"
                                      Click="Minutes_Click"/>

                        <TextBox x:Name="CustomMinutesInput" Style="{StaticResource MdInput}" Width="58"
                                 Padding="6,4" VerticalAlignment="Center"
                                 AutomationProperties.AutomationId="ScreenBreakMinutesInput"/>
                        <Button Style="{StaticResource MdGhostButton}" Content="Apply" Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="ScreenBreakApplyButton" Click="ApplyMinutes_Click"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Style="{StaticResource MdSecondaryButton}" Content="Remind me now"
                                AutomationProperties.AutomationId="ScreenBreakRemindButton" Click="RemindNow_Click"/>
                        <Button Style="{StaticResource MdGhostButton}" Content="Reset timer" Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="ScreenBreakResetButton" Click="ResetTimer_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid Margin="1,14,0,4">
                <TextBlock Style="{StaticResource MdSectionTitle}" Text="RECENT SESSIONS" Margin="0"/>
                <TextBlock x:Name="SessionSummaryText" Style="{StaticResource MdCaption}"
                           HorizontalAlignment="Right" VerticalAlignment="Top"/>
            </Grid>

            <StackPanel x:Name="SessionPanel"/>
            <TextBlock x:Name="EmptySessionsText" Style="{StaticResource MdCaption}" Margin="1,2,0,0"
                       Text="No breathing sessions yet."/>
        </StackPanel>
    </Grid>
</UserControl>
