<UserControl x:Class="RightDock.Modules.Statistics.StatisticsCompactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             TextOptions.TextFormattingMode="Display"
             UseLayoutRounding="True" SnapsToDevicePixels="True">

    <StackPanel>
        <Grid Margin="1,0,0,6">
            <TextBlock Style="{StaticResource MdSectionTitle}" Text="STATISTICS" Margin="0"/>
            <TextBlock x:Name="RangeText" Style="{StaticResource MdCaption}" HorizontalAlignment="Right"/>
        </Grid>

        <Border Style="{StaticResource MdCard}" Padding="14">
            <StackPanel>
                <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,8,10">
                        <TextBlock Style="{StaticResource MdCaption}" Text="Focus time"/>
                        <TextBlock x:Name="FocusValue" Style="{StaticResource MdValue}"
                                   AutomationProperties.AutomationId="StatsFocusValue"/>
                        <TextBlock x:Name="FocusMeta" Style="{StaticResource MdCaption}"/>
                    </StackPanel>

                    <StackPanel Margin="8,0,0,10">
                        <TextBlock Style="{StaticResource MdCaption}" Text="Tasks completed"/>
                        <TextBlock x:Name="TaskValue" Style="{StaticResource MdValue}"
                                   AutomationProperties.AutomationId="StatsTaskValue"/>
                        <TextBlock x:Name="TaskMeta" Style="{StaticResource MdCaption}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Style="{StaticResource MdCaption}" Text="Habit check-ins"/>
                        <TextBlock x:Name="HabitValue" Style="{StaticResource MdValue}"
                                   AutomationProperties.AutomationId="StatsHabitValue"/>
                        <TextBlock x:Name="HabitMeta" Style="{StaticResource MdCaption}"/>
                    </StackPanel>

                    <StackPanel Margin="8,0,0,0">
                        <TextBlock Style="{StaticResource MdCaption}" Text="Medication adherence"/>
                        <TextBlock x:Name="MedValue" Style="{StaticResource MdValue}"
                                   AutomationProperties.AutomationId="StatsMedicationValue"/>
                        <TextBlock x:Name="MedMeta" Style="{StaticResource MdCaption}"/>
                    </StackPanel>
                </UniformGrid>

                <Border Style="{StaticResource MdDivider}" Margin="0,12,0,10"/>

                <TextBlock x:Name="ChartTitle" Style="{StaticResource MdSectionTitle}" Margin="0"/>
                <UniformGrid x:Name="MiniChart" Height="64" Margin="0,2,0,0"
                             AutomationProperties.AutomationId="StatsMiniChart"/>
            </StackPanel>
        </Border>

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Style="{StaticResource MdPrimaryButton}" Content="Open statistics"
                    AutomationProperties.AutomationId="StatsOpenButton" Click="Open_Click"/>
            <Button Grid.Column="1" Style="{StaticResource MdSecondaryButton}" Content="Refresh"
                    Margin="8,0,0,0" Click="Refresh_Click"/>
        </Grid>
    </StackPanel>
</UserControl>
