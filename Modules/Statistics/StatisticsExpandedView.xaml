<UserControl x:Class="RightDock.Modules.Statistics.StatisticsExpandedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             TextOptions.TextFormattingMode="Display"
             UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="1,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource MdTitle}" Text="Statistics" VerticalAlignment="Center"/>
                <TextBlock x:Name="RangeText" Style="{StaticResource MdCaption}" Margin="12,0,0,1"
                           VerticalAlignment="Bottom"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ToggleButton x:Name="DailyChip" Style="{StaticResource MdChip}" Content="Daily"
                              Tag="daily" Click="Granularity_Click"/>
                <ToggleButton x:Name="WeeklyChip" Style="{StaticResource MdChip}" Content="Weekly"
                              Tag="weekly" Click="Granularity_Click"/>
                <ToggleButton x:Name="MonthlyChip" Style="{StaticResource MdChip}" Content="Monthly"
                              Tag="monthly" Click="Granularity_Click"/>
                <Button Style="{StaticResource MdSecondaryButton}" Content="Refresh" Margin="6,0,0,5"
                        AutomationProperties.AutomationId="StatsRefreshButton" Click="Refresh_Click"/>
            </StackPanel>
        </Grid>

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
            <Border Style="{StaticResource MdCard}" Padding="12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource MdCaption}" Text="Focus time"/>
                    <TextBlock x:Name="SummaryFocusValue" FontSize="19" FontWeight="SemiBold"
                               Foreground="#F5F5F5"
                               AutomationProperties.AutomationId="StatsSummaryFocus"/>
                    <TextBlock x:Name="SummaryFocusMeta" Style="{StaticResource MdCaption}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MdCard}" Padding="12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource MdCaption}" Text="Tasks completed"/>
                    <TextBlock x:Name="SummaryTaskValue" FontSize="19" FontWeight="SemiBold"
                               Foreground="#F5F5F5"
                               AutomationProperties.AutomationId="StatsSummaryTasks"/>
                    <TextBlock x:Name="SummaryTaskMeta" Style="{StaticResource MdCaption}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MdCard}" Padding="12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource MdCaption}" Text="Habit check-ins"/>
                    <TextBlock x:Name="SummaryHabitValue" FontSize="19" FontWeight="SemiBold"
                               Foreground="#F5F5F5"
                               AutomationProperties.AutomationId="StatsSummaryHabits"/>
                    <TextBlock x:Name="SummaryHabitMeta" Style="{StaticResource MdCaption}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MdCard}" Padding="12">
                <StackPanel>
                    <TextBlock Style="{StaticResource MdCaption}" Text="Medication adherence"/>
                    <TextBlock x:Name="SummaryMedValue" FontSize="19" FontWeight="SemiBold"
                               Foreground="#F5F5F5"
                               AutomationProperties.AutomationId="StatsSummaryMedication"/>
                    <TextBlock x:Name="SummaryMedMeta" Style="{StaticResource MdCaption}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Style="{StaticResource MdCard}" Grid.Row="2" Margin="0,0,0,12" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <TextBlock x:Name="ChartTitle" Style="{StaticResource MdSectionTitle}" Margin="0"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ToggleButton x:Name="MetricFocusChip" Style="{StaticResource MdChip}" Content="Focus"
                                      Tag="focus" Click="Metric_Click"/>
                        <ToggleButton x:Name="MetricTaskChip" Style="{StaticResource MdChip}" Content="Tasks"
                                      Tag="tasks" Click="Metric_Click"/>
                        <ToggleButton x:Name="MetricHabitChip" Style="{StaticResource MdChip}" Content="Habits"
                                      Tag="habits" Click="Metric_Click"/>
                        <ToggleButton x:Name="MetricMedicationChip" Style="{StaticResource MdChip}"
                                      Content="Medication" Tag="medication" Click="Metric_Click"/>
                    </StackPanel>
                </Grid>

                <UniformGrid x:Name="ChartPanel" Grid.Row="1" Height="150" Margin="0,10,0,0"
                             VerticalAlignment="Bottom"
                             AutomationProperties.AutomationId="StatsChartPanel"/>

                <TextBlock x:Name="ChartCaption" Grid.Row="2" Style="{StaticResource MdCaption}"
                           Margin="0,8,0,0"/>
            </Grid>
        </Border>

        <Border Style="{StaticResource MdCard}" Grid.Row="3" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,17,0">
                    <TextBlock Style="{StaticResource MdSectionTitle}" Text="BREAKDOWN" Margin="0"/>
                    <TextBlock x:Name="TableRange" Style="{StaticResource MdCaption}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <ScrollViewer Grid.Row="1" MaxHeight="132" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="TablePanel"
                                AutomationProperties.AutomationId="StatsTablePanel"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
