<UserControl x:Class="RightDock.Modules.Tasks.TasksCompactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             TextOptions.TextFormattingMode="Display"
             UseLayoutRounding="True" SnapsToDevicePixels="True">

    <StackPanel>
        <Grid Margin="0,0,0,7">
            <StackPanel>
                <TextBlock Style="{StaticResource MdSectionTitle}" Text="TODAY" Margin="1,0,0,0"/>
                <TextBlock x:Name="DateText" Style="{StaticResource MdCaption}" Margin="1,1,0,0"/>
            </StackPanel>
            <TextBlock x:Name="CountText" Style="{StaticResource MdCaption}" VerticalAlignment="Bottom"
                       HorizontalAlignment="Right"/>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="QuickAdd" Style="{StaticResource MdInput}" KeyDown="QuickAdd_KeyDown"
                     AutomationProperties.AutomationId="TaskQuickAdd" VerticalContentAlignment="Center"/>
            <Button Grid.Column="1" Style="{StaticResource MdPrimaryButton}" Content="Add"
                    Margin="6,0,0,0" Padding="13,6" Click="Add_Click"/>
        </Grid>

        <TextBlock x:Name="QuickHint" Style="{StaticResource MdCaption}" Margin="1,5,0,0"
                   Text="Type a title and press Enter."/>

        <StackPanel x:Name="TaskPanel" Margin="0,10,0,0"/>
        <TextBlock x:Name="EmptyText" Style="{StaticResource MdCaption}" Margin="1,2,0,0"
                   Text="Nothing due today."/>

        <Button Style="{StaticResource MdGhostButton}" Content="Open dashboard"
                FontSize="10.5" HorizontalAlignment="Right" Margin="0,10,0,0" Click="Open_Click"/>
    </StackPanel>
</UserControl>
