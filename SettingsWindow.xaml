<Window x:Class="RightDock.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="560" Height="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <LinearGradientBrush x:Key="Rainbow" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#F25555"/>
            <GradientStop Offset="0.17" Color="#F2A455"/>
            <GradientStop Offset="0.34" Color="#E8E855"/>
            <GradientStop Offset="0.5" Color="#55D97B"/>
            <GradientStop Offset="0.67" Color="#55C8F2"/>
            <GradientStop Offset="0.84" Color="#7B7BF2"/>
            <GradientStop Offset="1" Color="#E055D9"/>
        </LinearGradientBrush>

        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2EFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9CC7E9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="2,1">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#C9E4FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9A9A9A"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1FFFFFFF"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="1">
                                <Setter TargetName="Bg" Property="Background" Value="#3DFFFFFF"/>
                                <Setter Property="Foreground" Value="#F7F7F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleSwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Track" CornerRadius="12" Background="#3A3A3A"
                                    BorderBrush="#3FFFFFFF" BorderThickness="1"/>
                            <Border x:Name="Thumb" Width="16" Height="16" CornerRadius="8"
                                    Background="#B4B4B4" HorizontalAlignment="Left" Margin="4,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#E6E6E6"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="Transparent"/>
                                <Setter TargetName="Thumb" Property="Background" Value="#1C1C1C"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,4,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Thumb" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Ring" CornerRadius="20" BorderThickness="2"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <Border Width="30" Height="30" CornerRadius="15"
                                    Background="{TemplateBinding Background}">
                                <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="Segoe Fluent Icons"
                                           FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}" Visibility="Collapsed"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="#66FFFFFF"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="1">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="#FFFFFF"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A8A8A"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,0,0,6"/>
            <Setter Property="Text" Value="SECTION"/>
        </Style>

        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EDEDED"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="RowDescription" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8C8C8C"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,12,0"/>
        </Style>

        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="#1FFFFFFF"/>
            <Setter Property="Margin" Value="2,16,2,16"/>
        </Style>
    </Window.Resources>

    <Border Margin="14" CornerRadius="14" Background="#FF242424"
            BorderBrush="#2EFFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.45" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="14,10,14,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid x:Name="HeaderBar" Grid.Row="0" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Settings" Foreground="#F2FFFFFF" FontSize="14"
                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,0,0"/>
                <Button Grid.Column="1" Style="{StaticResource ChromeButton}" Click="Close_Click"
                        ToolTip="Close">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="12"
                               Foreground="#D6D6D6"/>
                </Button>
            </Grid>

            <Border Grid.Row="1" Background="#2B2B2B" BorderBrush="#3AFFFFFF" BorderThickness="1"
                    CornerRadius="9" Padding="3" Margin="0,10,0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="TabGeneral" Grid.Column="0" Style="{StaticResource TabButton}"
                            Content="General" Click="Tab_Click"/>
                    <Button x:Name="TabAppearance" Grid.Column="1" Style="{StaticResource TabButton}"
                            Content="Appearance" Click="Tab_Click"/>
                    <Button x:Name="TabModules" Grid.Column="2" Style="{StaticResource TabButton}"
                            Content="Modules" Click="Tab_Click"/>
                    <Button x:Name="TabNotifications" Grid.Column="3" Style="{StaticResource TabButton}"
                            Content="Notifications" Click="Tab_Click"/>
                    <Button x:Name="TabData" Grid.Column="4" Style="{StaticResource TabButton}"
                            Content="Data" Click="Tab_Click"/>
                    <Button x:Name="TabStartup" Grid.Column="5" Style="{StaticResource TabButton}"
                            Content="Startup" Click="Tab_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,10,0,0">

                <StackPanel x:Name="PageGeneral" Visibility="Visible">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="BEHAVIOR"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Auto-hide"/>
                            <TextBlock Style="{StaticResource RowDescription}"
                                       Text="Slide the dock off-screen when the mouse leaves it."/>
                        </StackPanel>
                        <ToggleButton x:Name="AutoHideToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      VerticalAlignment="Center"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <TextBlock Foreground="#8C8C8C" FontSize="11" TextWrapping="Wrap" LineHeight="17"
                               Text="While hidden, the 50 px strip is released so maximized windows use the full width. Move the mouse to the right screen edge to bring the dock back."/>
                </StackPanel>

                <StackPanel x:Name="PageAppearance" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="ICON COLOR"/>
                    <TextBlock Style="{StaticResource RowDescription}" Margin="2,0,0,6"
                               Text="Applies to every line icon in the dock."/>
                    <WrapPanel x:Name="SwatchPanel" Margin="0,4,0,0"/>
                    <TextBlock x:Name="ColorValueText" Margin="5,12,0,0" FontSize="11.5"
                               Foreground="#CFCFCF"/>
                    <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left"
                            Margin="3,6,0,0" Content="Choose custom color…" Click="PickCustom_Click"/>
                    <Border Style="{StaticResource Divider}"/>
                    <TextBlock Foreground="#8C8C8C" FontSize="11" TextWrapping="Wrap" LineHeight="17"
                               Text="Apps set to show their own icon keep the original shell colors."/>
                </StackPanel>

                <StackPanel x:Name="PageStartup" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="WINDOWS STARTUP"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Start with Windows"/>
                            <TextBlock Style="{StaticResource RowDescription}"
                                       Text="Launch Right Dock automatically when you sign in."/>
                        </StackPanel>
                        <ToggleButton x:Name="StartupToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock x:Name="StartupError" Foreground="#FF8A8A" FontSize="11"
                               TextWrapping="Wrap" Margin="2,10,0,0" Visibility="Collapsed"/>
                    <Border Style="{StaticResource Divider}"/>
                    <TextBlock Foreground="#7F7F7F" FontSize="10.5" TextWrapping="Wrap" LineHeight="16">
                        <Run Text="Startup entry: "/><Run x:Name="StartupPathRun" Foreground="#9A9A9A"/>
                    </TextBlock>
                </StackPanel>

                <ScrollViewer x:Name="PageModules" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,6,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="PRODUCTIVITY MODULES"/>
                        <TextBlock x:Name="ModulesEmptyText" Style="{StaticResource RowDescription}"
                                   Margin="2,0,0,4"
                                   Text="No modules are registered yet."/>
                        <StackPanel x:Name="ModulesList"/>
                        <Border Style="{StaticResource Divider}"/>
                        <TextBlock Foreground="#8C8C8C" FontSize="11" TextWrapping="Wrap" LineHeight="17"
                                   Text="Disabling a module removes it from the dock but keeps its data. Use &quot;Hide from dock&quot; to keep a module running without its dock icon."/>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel x:Name="PageNotifications" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="NOTIFICATIONS"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Show notifications"/>
                            <TextBlock Style="{StaticResource RowDescription}"
                                       Text="Reminders, timers and module alerts appear as RightDock cards."/>
                        </StackPanel>
                        <ToggleButton x:Name="NotificationsToggle" Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left"
                            Content="Send test notification" Click="TestNotification_Click"/>
                    <TextBlock x:Name="NotificationStatus" Margin="2,8,0,0" FontSize="11"
                               TextWrapping="Wrap" Visibility="Collapsed"/>
                    <TextBlock Foreground="#7F7F7F" FontSize="10.5" TextWrapping="Wrap"
                               LineHeight="16" Margin="0,14,0,0"
                               Text="Notifications appear as RightDock cards in the bottom-right corner and fade out after a few seconds. Clicking a card runs its action, such as opening the related module."/>
                </StackPanel>

                <ScrollViewer x:Name="PageData" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,6,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="LOCAL DATA"/>
                        <TextBlock x:Name="DataPathText" Foreground="#9A9A9A" FontSize="10.5"
                                   TextWrapping="Wrap" LineHeight="15" Margin="2,0,0,0"/>
                        <TextBlock x:Name="DataSummaryText" Foreground="#CFCFCF" FontSize="11.5"
                                   Margin="2,8,0,0"/>
                        <WrapPanel Margin="0,6,0,0">
                            <Button x:Name="OpenDataFolderButton" Style="{StaticResource LinkButton}"
                                    Content="Open data folder" Margin="2,0,18,0"
                                    Click="OpenDataFolder_Click"
                                    AutomationProperties.AutomationId="OpenDataFolderButton"/>
                            <Button x:Name="RunDiagnosticsButton" Style="{StaticResource LinkButton}"
                                    Content="Run integrity check"
                                    Click="RunDiagnostics_Click"
                                    AutomationProperties.AutomationId="RunDiagnosticsButton"/>
                        </WrapPanel>
                        <TextBlock x:Name="DataStatusText" Margin="2,8,0,0" FontSize="11"
                                   TextWrapping="Wrap" Visibility="Collapsed"/>
                        <Border Style="{StaticResource Divider}"/>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="BACKUP"/>
                        <TextBlock Style="{StaticResource RowDescription}" Margin="2,0,0,6"
                                   Text="Create one archive with the database, pins, settings and custom icons."/>
                        <Button x:Name="CreateBackupButton" Style="{StaticResource LinkButton}"
                                HorizontalAlignment="Left" Content="Create backup…"
                                Click="CreateBackup_Click"
                                AutomationProperties.AutomationId="CreateBackupButton"/>
                        <TextBlock x:Name="BackupStatusText" Margin="2,8,0,0" FontSize="11"
                                   TextWrapping="Wrap" Visibility="Collapsed"/>
                        <Border Style="{StaticResource Divider}"/>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="RESTORE"/>
                        <TextBlock Style="{StaticResource RowDescription}" Margin="2,0,0,6"
                                   Text="Restoring replaces current data and restarts RightDock. A safety copy of the current database is kept in the backup folder."/>
                        <Button x:Name="RestoreBackupButton" Style="{StaticResource LinkButton}"
                                HorizontalAlignment="Left" Content="Restore backup…"
                                Click="RestoreBackup_Click"
                                AutomationProperties.AutomationId="RestoreBackupButton"/>
                        <TextBlock x:Name="RestoreStatusText" Margin="2,8,0,0" FontSize="11"
                                   TextWrapping="Wrap" Visibility="Collapsed"/>
                        <Border Style="{StaticResource Divider}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="AboutText" Foreground="#7F7F7F" FontSize="10.5"
                                       VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <Button x:Name="CopyDiagnosticsButton" Grid.Column="1"
                                    Style="{StaticResource LinkButton}" Content="Copy diagnostics"
                                    Margin="12,0,2,0" Click="CopyDiagnostics_Click"
                                    AutomationProperties.AutomationId="CopyDiagnosticsButton"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

            </Grid>

            <Grid Grid.Row="3" Margin="2,10,2,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Changes apply immediately." Foreground="#7F7F7F" FontSize="10.5"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1" Style="{StaticResource LinkButton}" Content="Done"
                        Click="Close_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
